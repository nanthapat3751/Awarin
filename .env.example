# --- server/.env ---

# Superuser connection — used only by `prisma migrate`/`prisma generate`/`prisma db seed`.
DATABASE_URL="postgresql://boq:boq_dev_password@localhost:5432/systemboq?schema=public"

# Restricted role the running Express app actually connects as (no DDL, no
# UPDATE/DELETE on "AuditLog"). Created by prisma/init/01-create-runtime-role.sql on
# first container start and (re-)granted idempotently by prisma/seed.ts. Required —
# the app throws on boot if this is missing rather than silently using the superuser.
DATABASE_URL_RUNTIME="postgresql://boq_app:boq_app_dev_password@localhost:5432/systemboq?schema=public"

# Separate database used ONLY by `npm test` (tests/setup-env.ts requires these and swaps
# them in over DATABASE_URL/DATABASE_URL_RUNTIME for the test process) — never the same
# database as dev, so running the test suite can't pollute what you see in the running app.
# Created automatically by prisma/init/02-create-test-db.sql on first container start; see
# README's "ฐานข้อมูลสำหรับทดสอบ (test database)" section for the one-time migrate+grant setup.
DATABASE_URL_TEST="postgresql://boq:boq_dev_password@localhost:5432/systemboq_test?schema=public"
DATABASE_URL_TEST_RUNTIME="postgresql://boq_app:boq_app_dev_password@localhost:5432/systemboq_test?schema=public"

PORT=4000
NODE_ENV=development
# Separate cookie names per app so a staff login and a customer login can coexist in the
# same browser without one overwriting the other's session.
SESSION_COOKIE_NAME_STAFF=systemboq_staff_session
SESSION_COOKIE_NAME_CUSTOMER=systemboq_customer_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
CORS_ORIGIN_STAFF=http://localhost:5173
CORS_ORIGIN_CLIENT=http://localhost:5174
