
# ── ที่อยู่เว็บฝั่งลูกค้า ──
# ใช้ประกอบลิงก์ที่ "ระบบส่งออกไปเอง" ทางอีเมล: ลิงก์ตั้งรหัสผ่านใหม่ (ลืมรหัสผ่าน)
# และลิงก์เปิดใช้บัญชีที่ทีมงานออกให้
#
# **ต้องตั้งตอน deploy** ถ้าไม่ตั้ง ระบบจะถอยไปใช้ CORS_ORIGIN_CLIENT แล้วถึงจะเป็น
# http://localhost:5174 — ลูกค้าจะได้อีเมลที่มีลิงก์ชี้กลับมาที่เครื่องตัวเอง กดแล้วไม่มีอะไรเกิดขึ้น
# (เมื่อก่อนพนักงานเป็นคนคัดลอกลิงก์ส่งเอง เลยเห็นทันทีว่าผิด ตอนนี้ระบบส่งเองจึงไม่มีใครเห็น)
CLIENT_BASE_URL=http://localhost:5174

# ── ที่อยู่เว็บฝั่งพนักงาน ──
# ลิงก์ตั้งรหัสผ่านใหม่ของพนักงาน (ลืมรหัสผ่าน → เมลไปที่อีเมลกู้รหัสที่ยืนยันแล้ว / คำสั่ง npm run staff:recover)
# **ต้องตั้งตอน deploy** ถ้าไม่ตั้งจะถอยไปใช้ CORS_ORIGIN_STAFF แล้วถึงจะเป็น http://localhost:5173
STAFF_BASE_URL=http://localhost:5173

# ── ส่งอีเมล (ยืนยันอีเมลลูกค้า · ลิงก์ตั้งรหัสผ่านใหม่) ──
# console = พิมพ์เมลลง log ไม่ส่งจริง (ค่าเริ่มต้น ใช้ตอน dev) · silent = ไม่ส่งไม่พิมพ์ (เทสต์)
# smtp = ส่งจริง ต้องตั้ง SMTP_* ให้ครบ
MAIL_TRANSPORT=console
MAIL_FROM="Awarin Engineering <no-reply@awarin.co.th>"
# ใช้ได้กับทุกเจ้าที่มี SMTP: Resend · Brevo · Amazon SES · Gmail (App Password)
# ตัวอย่าง Brevo: smtp-relay.brevo.com:587 · Resend: smtp.resend.com:587 · Gmail: smtp.gmail.com:587
#
# Gmail (เหมาะกับเดโม/ทดสอบ ~500 ฉบับต่อวัน):
#   1. เปิดการยืนยันตัวตน 2 ขั้นของบัญชี Google ก่อน
#   2. สร้าง App Password ที่ https://myaccount.google.com/apppasswords → ได้รหัส 16 ตัว
#   3. MAIL_TRANSPORT=smtp · SMTP_HOST=smtp.gmail.com · SMTP_PORT=587 · SMTP_SECURE=false
#      SMTP_USER=บัญชี@gmail.com · SMTP_PASS=รหัส 16 ตัว ลบช่องว่างออกให้ติดกัน (ไม่ใช่รหัสผ่าน Gmail ปกติ)
#      MAIL_FROM="Awarin Engineering <บัญชี@gmail.com>" ← ต้องเป็นอีเมลเดียวกับ SMTP_USER
#   4. รีสตาร์ต API — log บอกทันทีว่าเชื่อมต่อได้ไหม · หรือเช็กที่ ตั้งค่า → การส่งอีเมล (เฉพาะ OWNER)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ตรวจว่าโดเมนของอีเมลรับเมลได้จริงตอนสร้างบัญชี (ถาม MX ผ่าน DNS) — off เพื่อปิด
EMAIL_MX_CHECK=on

# --- ประเทศ/ผู้ให้บริการของไอพีในแฟ้มลูกค้า (DB-IP Lite ออฟไลน์ ไม่ส่งไอพีออกนอกเครื่อง) ---
# เซิร์ฟเวอร์ดาวน์โหลดไฟล์เองหลังเปิด ~30 วิ และทุกเดือน — false = ปิด (เครื่องที่ออกเน็ตไม่ได้ ให้รัน npm run geoip:update -w server เอง)
GEOIP_AUTO_UPDATE=true
# ประเทศหลักของบริษัท — ไอพีนอกประเทศนี้ได้ป้าย "ต่างประเทศ"
GEOIP_HOME_COUNTRY=TH
# ที่เก็บไฟล์ (ไม่ตั้ง = server/data/geoip)
GEOIP_DIR=

# --- ตรวจสลิปอัตโนมัติตอนลูกค้าแจ้งโอน (ว่าง = ปิด พนักงานตรวจกับบัญชีเองแบบเดิม) ---
#   slipok = ใช้ SlipOK — ต้องมี SLIPOK_API_KEY + SLIPOK_BRANCH_ID จากหน้าบัญชี SlipOK (ขาดตัวใดตัวหนึ่ง = ปิด)
#   mock   = จำลองผลจากชื่อไฟล์ (mockslip_<ยอด>_<เลขอ้างอิง>_<YYYYMMDD>_<เลขบัญชี>.png) เครื่องนักพัฒนาเท่านั้น ปิดเองบน production
# เปิดแล้วต้องมีหัวข้อ SlipOK ในหน้านโยบายความเป็นส่วนตัว (มีแล้ว) — ถ้าไม่เปิดใช้จริง ให้เอาหัวข้อนั้นออก
SLIP_PROVIDER=
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# --- รันหลายตัวหลัง load balancer (ดู README "รันหลายตัวหลัง load balancer") ---
# จำนวน hop ของ proxy ข้างหน้า — ต้องตั้งเมื่ออยู่หลัง LB (ไม่ตั้ง = ทุกคนได้ไอพีของ LB แชร์เพดานเดียว)
# ห้ามตั้งถ้าไม่มี proxy จริง (client ปลอมไอพีผ่าน X-Forwarded-For ได้)
TRUST_PROXY=
# การเชื่อมต่อ DB ต่อ API หนึ่งตัว — (จำนวนตัว × ค่านี้) + สำรองข้อมูล/pgAdmin ต้องไม่เกิน max_connections (100)
DATABASE_POOL_SIZE=
# ชื่อของ API ตัวนี้ — ตั้งแล้วทุกคำตอบมี header X-Served-By ไว้ดูว่า LB กระจายงานจริง
INSTANCE_ID=
# ตอนปิด: รอให้ LB เห็นว่า /api/health/ready เป็น 503 ก่อนหยุดรับงาน (ms) — production ตั้งราวสองเท่าของรอบตรวจของ LB
SHUTDOWN_DRAIN_MS=0
