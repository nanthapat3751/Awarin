# ═══════════════════════════════════════════════════════════════════════════
# ค่าตั้งสำหรับเซิร์ฟเวอร์จริง (production) — คัดลอกเป็น server/.env บนเครื่องเซิร์ฟเวอร์แล้วเติมค่า
#
# ตอนเปิด ระบบตรวจค่าในไฟล์นี้เอง (src/lib/deploy-check.ts) ถ้ายังตั้งไม่ครบจะ "ไม่ยอมเปิด"
# และบอกว่าขาดอะไร — ดีกว่าเปิดได้แล้วลิงก์ในอีเมลพังเงียบ ๆ
#
# ค่าที่ไม่ได้อยู่ในไฟล์นี้ ดูคำอธิบายใน .env.example (GEOIP, TRUST_PROXY, สำรองข้อมูล ฯลฯ)
# ทุกค่าที่เป็น "example.co.th" ให้เปลี่ยนเป็นโดเมนจริงของบริษัท
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000

# ── ฐานข้อมูล ──
# รหัสผ่าน DB ต้องเปลี่ยนจากค่าตอนพัฒนา · ห้ามเปิดพอร์ต 5432 และ pgAdmin ออกอินเทอร์เน็ต
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/systemboq
DATABASE_URL_RUNTIME=postgresql://boq_app:PASSWORD@localhost:5432/systemboq

# ── ที่อยู่เว็บ (ข้อ 1) ──
# ลิงก์ในอีเมลประกอบจากค่านี้ (ตั้งรหัสผ่านใหม่ · เปิดใช้บัญชี · กู้รหัสพนักงาน)
# ต้องเป็น https:// และเป็นโดเมนจริง — localhost หรือ http:// ระบบไม่ยอมเปิด
CLIENT_BASE_URL=https://www.example.co.th
STAFF_BASE_URL=https://staff.example.co.th
# ปกติใช้ค่าเดียวกับสองบรรทัดบน (เว็บที่อนุญาตให้เรียก API)
CORS_ORIGIN_CLIENT=https://www.example.co.th
CORS_ORIGIN_STAFF=https://staff.example.co.th

# ── HTTPS และคุกกี้ (ข้อ 4) ──
# เว็บต้องเปิดผ่าน HTTPS ก่อน (ใบรับรองฟรีจาก Let's Encrypt ผ่าน nginx/Caddy หรือผู้ให้บริการโฮสต์)
# แล้วตั้ง COOKIE_SECURE=true — คุกกี้เข้าสู่ระบบจะส่งเฉพาะผ่าน HTTPS · false ระบบไม่ยอมเปิด
COOKIE_SECURE=true
SESSION_COOKIE_NAME_STAFF=systemboq_staff_session
SESSION_COOKIE_NAME_CUSTOMER=systemboq_customer_session
SESSION_TTL_HOURS=12
# ถ้าอยู่หลัง nginx/Caddy/load balancer ให้ตั้งจำนวน hop (ส่วนใหญ่ = 1) — ไม่มี proxy ห้ามตั้ง
TRUST_PROXY=1

# ── ส่งอีเมล (ข้อ 2) ──
# ต้องเป็น smtp — ค่าอื่นไม่ส่งจริง ลูกค้าจะไม่ได้รหัสยืนยัน ระบบไม่ยอมเปิด
MAIL_TRANSPORT=smtp
#
# แนะนำ: อีเมลโดเมนบริษัท ไม่ใช่ Gmail ส่วนตัว
#   (ระบบยังเปิดได้ถ้าใช้ Gmail แต่จะเตือนใน log ทุกครั้ง — เสี่ยงเข้าสแปม · ~500 ฉบับ/วัน · ลูกค้าไม่คุ้นชื่อ)
#
# ทางเลือก A — มีกล่องจดหมายของบริษัทอยู่แล้ว (Google Workspace / Microsoft 365 / Zoho Mail)
#   สร้างบัญชี no-reply@example.co.th แล้วใช้ SMTP ของผู้ให้บริการนั้น
#     Google Workspace : smtp.gmail.com:587 + App Password ของบัญชีนั้น
#     Microsoft 365    : smtp.office365.com:587
#     Zoho Mail        : smtp.zoho.com:587
#
# ทางเลือก B — บริการส่งอีเมลของระบบ (ไม่ต้องมีกล่องจดหมาย · มีโควตาฟรี)
#     Brevo  : smtp-relay.brevo.com:587   (ฟรี 300 ฉบับ/วัน)
#     Resend : smtp.resend.com:587        (ฟรี 3,000 ฉบับ/เดือน)
#   ยืนยันโดเมนในหน้าเว็บของบริการก่อน แล้วใช้ SMTP user/key ที่บริการให้
#
# ทั้งสองทาง ต้องเพิ่ม DNS ของโดเมน (ทำที่ผู้ให้บริการโดเมน) ไม่งั้นเมลเข้าสแปม:
#   SPF   : TXT  @       "v=spf1 include:<ค่าที่ผู้ให้บริการบอก> ~all"
#   DKIM  : TXT/CNAME ตามที่ผู้ให้บริการสร้างให้ (เช่น google._domainkey)
#   DMARC : TXT  _dmarc  "v=DMARC1; p=none; rua=mailto:dmarc@example.co.th"
#   ตรวจผลได้ที่ https://www.mail-tester.com (ส่งเมลทดสอบจากหน้า ตั้งค่า → การส่งอีเมล ไปที่อยู่ที่เว็บนั้นให้)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# ต้องเป็นอีเมลโดเมนเดียวกับเว็บ (ไม่งั้นระบบเตือน) และเป็นที่อยู่ที่ผู้ให้บริการอนุญาตให้ส่ง
MAIL_FROM="Awarin Engineering <no-reply@example.co.th>"
EMAIL_MX_CHECK=on

# ── สำรองข้อมูล ──
# เก็บสำเนาไว้นอกเครื่องเซิร์ฟเวอร์ด้วย (ดิสก์อีกลูก/คลาวด์) — เครื่องพังแล้วสำรองหายไปพร้อมกันไม่มีประโยชน์
BACKUP_DATABASE_URL=postgresql://boq_backup:PASSWORD@localhost:5432/systemboq
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2
BACKUP_MIRROR_DIR=

# ── ตรวจสลิปอัตโนมัติ (SlipOK) ──
# ว่าง = ปิด (พนักงานตรวจกับบัญชีเอง) · ใส่ key จากบัญชี SlipOK ของบริษัท — ห้ามใช้ mock บนเครื่องจริง
SLIP_PROVIDER=slipok
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
